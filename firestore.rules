rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth!= null && request.auth.token.admin == true;
    }

    // Numéro magasin : email technique "0556653220@elbouni.local"
    function numeroDepuisEmailTechnique() {
      return (request.auth!= null
              && 'email' in request.auth.token
              && request.auth.token.email.split('@').size() == 2
              && request.auth.token.email.split('@')[1] == 'elbouni.local')
       ? request.auth.token.email.split('@')[0]
        : null;
    }

    // Numéro acheteur : email technique "0556653220@vroumclient.local"
    function numeroClientDepuisEmail() {
      return (request.auth!= null
              && 'email' in request.auth.token
              && request.auth.token.email.split('@').size() == 2
              && request.auth.token.email.split('@')[1] == 'vroumclient.local')
       ? request.auth.token.email.split('@')[0]
        : null;
    }

    function isOwner(storeId) {
      return request.auth!= null
        && (request.auth.uid == storeId
            || numeroDepuisEmailTechnique() == storeId);
    }

    // Propriétaire d'une demande = clientId = uid Firebase OU numéro téléphone
    function isRequestOwner() {
      return request.auth!= null
        && (resource.data.clientId == request.auth.uid
            || resource.data.clientId == numeroClientDepuisEmail()
            || resource.data.clientId == numeroDepuisEmailTechnique());
    }

    function isRequestOwnerForCreate() {
      return request.auth!= null
        && (request.resource.data.clientId == request.auth.uid
            || request.resource.data.clientId == numeroClientDepuisEmail()
            || request.resource.data.clientId == numeroDepuisEmailTechnique());
    }

    // Même logique via get() pour la sous-collection offers
    function isParentRequestOwner(requestId) {
      let parent = get(/databases/$(database)/documents/part_requests/$(requestId)).data;
      return request.auth!= null
        && (parent.clientId == request.auth.uid
            || parent.clientId == numeroClientDepuisEmail()
            || parent.clientId == numeroDepuisEmailTechnique());
    }

    // Demandes de pièces
    match /part_requests/{requestId} {
      allow read: if true;
      // CORRIGÉ: ajout auth + vérif clientId
      allow create: if request.resource.data.statut == 'open'
                    && isRequestOwnerForCreate();
      // CORRIGÉ: ajout isRequestOwner() -> seul le créateur peut clôturer
      allow update: if isAdmin()
                    || (isRequestOwner()
                        && request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasOnly(['statut', 'soldToStoreId', 'soldToStoreNom', 'dateVente'])
                        && request.resource.data.statut in ['closed', 'vendu']);
      // Admin OU le créateur de la demande
      allow delete: if isAdmin() || isRequestOwner();

      match /offers/{offerId} {
        allow read: if true;
        allow create, update: if isAdmin()
                              || (isOwner(offerId) && subscriptionValide(offerId));
        // Admin, le magasin propriétaire de l'offre, ou l'acheteur qui supprime sa demande
        allow delete: if isAdmin()
                      || isOwner(offerId)
                      || isParentRequestOwner(requestId);
      }
    }

    // Comptes magasins
    match /stores/{storeId} {
      allow create: if isOwner(storeId)
                      && request.resource.data.actif == false
                      && request.resource.data.subscriptionStatus == 'essai';
      allow read: if isAdmin() || isOwner(storeId);
      allow update: if isAdmin()
                    || (isOwner(storeId)
                        && request.resource.data.actif == resource.data.actif
                        && request.resource.data.subscriptionStatus
                            == resource.data.subscriptionStatus
                        && request.resource.data.trialEndDate
                            == resource.data.trialEndDate
                        && request.resource.data.get('subscriptionEndDate', null)
                            == resource.data.get('subscriptionEndDate', null)
                        && request.resource.data.get('currentPlanId', null)
                            == resource.data.get('currentPlanId', null));
      allow delete: if isAdmin();

      match /payment_requests/{paymentId} {
        allow create: if isOwner(storeId)
                        && request.resource.data.storeId == storeId
                        && request.resource.data.statut == 'en_attente';
        allow read: if isAdmin() || isOwner(storeId);
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    function subscriptionValide(storeId) {
      let store = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return store.actif == true
        && (
          (store.subscriptionStatus == 'essai'
            && store.trialEndDate > request.time)
          || (store.subscriptionStatus == 'actif'
            && store.get('subscriptionEndDate', request.time) > request.time)
        );
    }
  }
}
