rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Numéro de téléphone dérivé de l'email technique Firebase Auth
    // "0556653220@elbouni.local" (voir StoreService.currentStoreDocId côté
    // app). Retourne null si l'utilisateur connecté n'a pas ce type
    // d'email (comptes Google / email classique créés avant ce système).
    function numeroDepuisEmailTechnique() {
      return (request.auth != null
              && 'email' in request.auth.token
              && request.auth.token.email.split('@').size() == 2
              && request.auth.token.email.split('@')[1] == 'elbouni.local')
        ? request.auth.token.email.split('@')[0]
        : null;
    }

    // Un magasin est propriétaire de storeId si :
    // - son UID Firebase Auth est directement storeId (anciens comptes
    //   Google / email, créés avec l'UID comme clé de document), ou
    // - storeId est son numéro de téléphone, dérivé de son email
    //   technique (nouveaux comptes téléphone + mot de passe).
    function isOwner(storeId) {
      return request.auth != null
        && (request.auth.uid == storeId
            || numeroDepuisEmailTechnique() == storeId);
    }

    // Demandes de pièces
    match /part_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.statut == 'open';
      allow update: if isAdmin()
                    || (request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['statut', 'soldToStoreId', 'soldToStoreNom', 'dateVente'])
                        && request.resource.data.statut in ['closed', 'vendu']);
      allow delete: if isAdmin();

      match /offers/{offerId} {
        allow read: if true;
        // offerId est l'ID du document magasin (stores/{offerId}), voir
        // respondToRequest() : un seul prix par magasin, ré-écrasable.
        allow create, update: if isAdmin()
                              || (isOwner(offerId) && subscriptionValide(offerId));
        allow delete: if isAdmin();
      }
    }

    // Comptes magasins
    match /stores/{storeId} {
      allow create: if isOwner(storeId)
                      && request.resource.data.actif == false
                      && request.resource.data.subscriptionStatus == 'essai';
      // Admin lit tout ; le magasin ne lit que le sien
      allow read: if isAdmin() || isOwner(storeId);
      // Admin peut tout modifier (activation, abo, blocage)
      allow update: if isAdmin()
                    || (isOwner(storeId)
                        && request.resource.data.actif == resource.data.actif
                        && request.resource.data.subscriptionStatus
                            == resource.data.subscriptionStatus
                        && request.resource.data.trialEndDate
                            == resource.data.trialEndDate
                        && request.resource.data.get('subscriptionEndDate', null)
                            == resource.data.get('subscriptionEndDate', null)
                        && request.resource.data.get('currentPlanId', null)
                            == resource.data.get('currentPlanId', null));
      allow delete: if isAdmin();

      match /payment_requests/{paymentId} {
        allow create: if isOwner(storeId)
                        && request.resource.data.storeId == storeId
                        && request.resource.data.statut == 'en_attente';
        allow read: if isAdmin() || isOwner(storeId);
        // Admin valide / refuse les preuves de paiement
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }

    function subscriptionValide(storeId) {
      let store = get(/databases/$(database)/documents/stores/$(storeId)).data;
      return store.actif == true
        && (
          (store.subscriptionStatus == 'essai'
            && store.trialEndDate > request.time)
          || (store.subscriptionStatus == 'actif'
            && store.get('subscriptionEndDate', request.time) > request.time)
        );
    }
  }
}
